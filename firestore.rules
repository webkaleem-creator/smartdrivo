rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is an authenticated administrator
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          request.auth.token.admin == true
        );
    }
    
    // Users collection rules
    match /users/{userId} {
      // Any authenticated user can read their own profile; Admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Creating a new user:
      // An authenticated user can create their own document, BUT cannot set isAdmin=true or isApproved=true
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId &&
          (!request.resource.data.keys().hasAny(['isAdmin', 'isApproved']) ||
           (request.resource.data.isAdmin == false && request.resource.data.isApproved == false))
        ) || isAdmin()
      );
      
      // Updating user:
      // Regular user can update their personal details (phone, vehicleType, city, etc.),
      // but CANNOT modify protected fields: isAdmin, isApproved, plan, planPrice, planExpireMillis, isActive
      // Admins have unrestricted update access.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'isApproved', 'plan', 'planPrice', 'planExpireMillis', 'isActive'])
        )
      );
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }
    
    // Payments collection rules
    match /payments/{paymentId} {
      // Drivers can read their own submissions; Admins can read all submissions
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      
      // Drivers can create payment submissions for their own UID with status PENDING
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'PENDING'
        )
      );
      
      // Only admins can approve, reject, or modify payment status
      allow update: if isAdmin();
      
      // Only admins can delete payment submissions
      allow delete: if isAdmin();
    }
    
    // Settings collection (global UPI, plan prices, community links)
    match /settings/{settingId} {
      // All authenticated users can read global settings
      allow read: if isAuthenticated();
      // Only admins can modify settings
      allow write: if isAdmin();
    }
    
    // Logs collection
    match /logs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
