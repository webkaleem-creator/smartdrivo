rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is an authenticated administrator
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          request.auth.token.admin == true
        );
    }
    
    // Users collection rules
    match /users/{userId} {
      // Any authenticated user can read their own profile; Admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // TRIAL_ABUSE_PROTECTION_V4
      // New driver docs may start only as FREE_TRIAL (with an atomic device
      // reservation) or NONE (same-device repeat trial blocked).
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          request.resource.data.isAdmin == false &&
          request.resource.data.isApproved == false &&
          request.resource.data.isActive == true &&
          request.resource.data.freeTrialUsed == true &&
          request.resource.data.trialDeviceKey is string &&
          (
            (
              request.resource.data.plan == 'FREE_TRIAL' &&
              request.resource.data.planPrice == 0 &&
              request.resource.data.planExpireMillis is int &&
              request.resource.data.planExpireMillis > 0 &&
              request.resource.data.freeTrialStartedAt is int &&
              request.resource.data.freeTrialStartedAt > 0 &&
              request.resource.data.trialDeniedReason == '' &&
              getAfter(
                /databases/$(database)/documents/trialDevices/$(request.resource.data.trialDeviceKey)
              ).data.firstUid == userId &&
              getAfter(
                /databases/$(database)/documents/trialDevices/$(request.resource.data.trialDeviceKey)
              ).data.deviceTrialKey == request.resource.data.trialDeviceKey
            ) ||
            (
              request.resource.data.plan == 'NONE' &&
              request.resource.data.planPrice == 0 &&
              request.resource.data.planExpireMillis == 0 &&
              request.resource.data.freeTrialStartedAt == 0 &&
              request.resource.data.trialDeniedReason == 'DEVICE_TRIAL_ALREADY_USED'
            )
          )
        )
      );
      
      // Updating user:
      // Regular users cannot alter membership, trial, admin, active-state,
      // or an existing device binding. Admins keep full control.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'isAdmin',
              'isApproved',
              'plan',
              'planPrice',
              'planExpireMillis',
              'isActive',
              'freeTrialStartedAt',
              'freeTrialUsed',
              'trialDeviceKey',
              'trialDeniedReason'
            ]) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['boundInstallId', 'boundDevice', 'deviceBoundAt']) ||
            (
              (!resource.data.keys().hasAny(['boundInstallId']) || resource.data.boundInstallId == '') &&
              request.resource.data.boundInstallId is string &&
              request.resource.data.boundInstallId != ''
            )
          )
        )
      );
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }
    
    // TRIAL_ABUSE_PROTECTION_V4
    // One immutable reservation per privacy-safe device token.
    match /trialDevices/{deviceKey} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();

      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.deviceTrialKey == deviceKey &&
          request.resource.data.firstUid == request.auth.uid &&
          request.resource.data.createdAt is int &&
          request.resource.data.trialExpireMillis is int &&
          (
            (
              getAfter(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.plan == 'FREE_TRIAL' &&
              getAfter(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.trialDeviceKey == deviceKey
            ) ||
            (
              exists(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ) &&
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.freeTrialUsed == true
            )
          )
        )
      );

      allow update, delete: if isAdmin();
    }

    // Payments collection rules
    match /payments/{paymentId} {
      // Drivers can read their own submissions; Admins can read all submissions
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      
      // Drivers can create payment submissions only with a deterministic
      // document id derived from the 12-digit UTR.
      // This prevents the same UTR being submitted again under a new random id.
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.utrNumber is string &&
          request.resource.data.utrNumber.matches('^[0-9]{12}$') &&
          request.resource.data.paymentId == paymentId &&
          paymentId == 'UTR-' + request.resource.data.utrNumber
        )
      );
      
      // Only admins can modify payment status.
      // A transition into APPROVED must atomically create the matching
      // immutable /paymentUtrs/{utr} reservation document.
      allow update: if isAdmin() && (
        request.resource.data.status != 'APPROVED' ||
        resource.data.status == 'APPROVED' ||
        (
          request.resource.data.utrNumber is string &&
          request.resource.data.uid is string &&
          getAfter(
            /databases/$(database)/documents/paymentUtrs/$(request.resource.data.utrNumber)
          ).data.paymentId == paymentId &&
          getAfter(
            /databases/$(database)/documents/paymentUtrs/$(request.resource.data.utrNumber)
          ).data.uid == request.resource.data.uid
        )
      );
      
      // Only admins can delete payment submissions
      allow delete: if isAdmin();
    }
    
    // Permanent approved-UTR reservations.
    // One UTR can be created only once and can never be overwritten/deleted.
    match /paymentUtrs/{utr} {
      allow read: if isAdmin();

      allow create: if isAdmin() &&
        request.resource.data.utrNumber == utr &&
        request.resource.data.paymentId is string &&
        request.resource.data.uid is string;

      allow update, delete: if false;
    }
    // Settings collection (global UPI, plan prices, community links)
    match /settings/{settingId} {
      // All authenticated users can read global settings
      allow read: if isAuthenticated();
      // Only admins can modify settings
      allow write: if isAdmin();
    }
    
    // Logs collection - admin only
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
