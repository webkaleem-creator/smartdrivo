rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is an authenticated administrator
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // SECURITY_V2B_SAFE_ADMIN_LOOKUP
    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.get('admin', false) == true ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
          )
        );
    }
    
    // SECURITY_V2B_TRIAL_RULES - PRODUCTION MERGE

    function trialPath(key) {
      return /databases/$(database)/documents/trialDevices/$(key);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function validNewDriver(uid) {
      let d = request.resource.data;

      return isAuthenticated() &&
        request.auth.uid == uid &&
        d.keys().hasAll([
          'uid', 'email', 'isAdmin', 'isApproved',
          'isActive', 'plan', 'planPrice',
          'planExpireMillis', 'freeTrialUsed',
          'freeTrialStartedAt', 'trialDeviceKey',
          'securityDeviceKey', 'createdAt'
        ]) &&
        d.uid == uid &&
        d.email is string &&
        d.email == request.auth.token.email &&
        d.isAdmin == false &&
        d.isApproved == false &&
        d.isActive == true &&
        d.planPrice == 0 &&
        d.freeTrialUsed == true &&
        d.trialDeviceKey is string &&
        d.trialDeviceKey.matches('^[a-f0-9]{64}$') &&
        d.securityDeviceKey == d.trialDeviceKey &&
        d.createdAt is int &&
        d.createdAt >= request.time.toMillis() - 600000 &&
        d.createdAt <= request.time.toMillis() + 600000 &&
        (
          (
            d.plan == 'NONE' &&
            d.planExpireMillis == 0 &&
            d.freeTrialStartedAt == 0
          ) ||
          (
            d.plan == 'FREE_TRIAL' &&
            d.freeTrialStartedAt == d.createdAt &&
            d.planExpireMillis == d.createdAt + 86400000 &&
            !exists(trialPath(d.trialDeviceKey)) &&
            existsAfter(trialPath(d.trialDeviceKey)) &&
            getAfter(trialPath(d.trialDeviceKey)).data.firstUid == uid &&
            getAfter(trialPath(d.trialDeviceKey)).data.deviceTrialKey == d.trialDeviceKey &&
            getAfter(trialPath(d.trialDeviceKey)).data.source == 'ANDROID_ID_SHA256_V4'
          )
        );
    }

    function validTrialReservation(key) {
      let d = request.resource.data;

      return isAuthenticated() &&
        d.keys().hasAll([
          'deviceTrialKey', 'firstUid',
          'createdAt', 'trialExpireMillis', 'source'
        ]) &&
        key.matches('^[a-f0-9]{64}$') &&
        d.deviceTrialKey == key &&
        d.firstUid == request.auth.uid &&
        d.createdAt is int &&
        d.createdAt >= request.time.toMillis() - 600000 &&
        d.createdAt <= request.time.toMillis() + 600000 &&
        d.trialExpireMillis is int &&
        (
          (
            d.source == 'ANDROID_ID_SHA256_V4' &&
            !exists(userPath(request.auth.uid)) &&
            existsAfter(userPath(request.auth.uid)) &&
            getAfter(userPath(request.auth.uid)).data.plan == 'FREE_TRIAL' &&
            getAfter(userPath(request.auth.uid)).data.trialDeviceKey == key &&
            getAfter(userPath(request.auth.uid)).data.planExpireMillis == d.trialExpireMillis
          ) ||
          (
            d.source == 'HISTORICAL_BACKFILL_V4' &&
            exists(userPath(request.auth.uid)) &&
            (
              get(userPath(request.auth.uid)).data.freeTrialUsed == true ||
              get(userPath(request.auth.uid)).data.plan == 'FREE_TRIAL'
            )
          )
        );
    }
    // Users collection rules
    match /users/{userId} {
      // Any authenticated user can read their own profile; Admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Membership and trial entitlement are server-protected.
      allow create: if validNewDriver(userId) || isAdmin();

      allow update: if isAdmin() ||
        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'uid', 'name', 'email', 'phone',
              'mobile', 'mobileNumber',
              'city', 'state', 'vehicleType',
              'referralCode', 'updatedAt',
              'lastDevice', 'lastAndroidVersion',
              'lastAppVersion', 'lastSeenAt',
              'securityDeviceKey',
              'registeredDevice',
              'registeredAndroidVersion',
              'registeredAppVersion',
              'registeredDeviceAt',
              'registeredDeviceSource',
              'activeSessionId', 'activeSessionAt',
              'activeSessionDevice',
              'activeSessionStartedAt',
              'activeSessionAppVersion',
              'boundInstallId', 'boundDevice', 'deviceBoundAt'
            ]) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['boundInstallId', 'boundDevice', 'deviceBoundAt']) ||
            (
              resource.data.get('boundInstallId', '') == '' &&
              request.resource.data.boundInstallId is string &&
              request.resource.data.boundInstallId != ''
            )
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'activeSessionDevice',
                'activeSessionStartedAt',
                'activeSessionAppVersion'
              ]) ||
            (
              request.resource.data.activeSessionId is string &&
              request.resource.data.activeSessionDevice is string &&
              request.resource.data.activeSessionStartedAt is int &&
              request.resource.data.activeSessionAppVersion is string
            )
          )
        );
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }
    
    // Trial reservations are immutable once created.
    match /trialDevices/{deviceKey} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if validTrialReservation(deviceKey);
      allow update, delete: if false;
    }
    // BLOCKED_USER_DEVICE_BLACKLIST_V1
    // Permanent device blacklist. Drivers can read the single hash document
    // for their current device; only admins can list or mutate the blacklist.
    match /blockedDevices/{deviceKey} {
      allow get: if isAuthenticated();
      allow list, create, update, delete: if isAdmin();
    }

    // Payments collection rules
    match /payments/{paymentId} {
      // Drivers can read their own submissions; Admins can read all submissions
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      
      // Drivers can create payment submissions only with a deterministic
      // document id derived from the 12-digit UTR.
      // This prevents the same UTR being submitted again under a new random id.
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.utrNumber is string &&
          request.resource.data.utrNumber.matches('^[0-9]{12}$') &&
          request.resource.data.paymentId == paymentId &&
          paymentId == 'UTR-' + request.resource.data.utrNumber
        )
      );
      
      // Only admins can modify payment status.
      // A transition into APPROVED must atomically create the matching
      // immutable /paymentUtrs/{utr} reservation document.
      allow update: if isAdmin() && (
        request.resource.data.status != 'APPROVED' ||
        resource.data.status == 'APPROVED' ||
        (
          request.resource.data.utrNumber is string &&
          request.resource.data.uid is string &&
          getAfter(
            /databases/$(database)/documents/paymentUtrs/$(request.resource.data.utrNumber)
          ).data.paymentId == paymentId &&
          getAfter(
            /databases/$(database)/documents/paymentUtrs/$(request.resource.data.utrNumber)
          ).data.uid == request.resource.data.uid
        )
      );
      
      // Only admins can delete payment submissions
      allow delete: if isAdmin();
    }
    
    // Permanent approved-UTR reservations.
    // One UTR can be created only once and can never be overwritten/deleted.
    match /paymentUtrs/{utr} {
      allow read: if isAdmin();

      allow create: if isAdmin() &&
        request.resource.data.utrNumber == utr &&
        request.resource.data.paymentId is string &&
        request.resource.data.uid is string;

      allow update, delete: if false;
    }
    // Settings collection (global UPI, plan prices, community links)
    match /settings/{settingId} {
      // All authenticated users can read global settings
      allow read: if isAuthenticated();
      // Only admins can modify settings
      allow write: if isAdmin();
    }
    
    // Logs collection - admin only
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
