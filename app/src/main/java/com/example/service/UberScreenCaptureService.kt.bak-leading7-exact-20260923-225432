package com.example.service

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Intent
import android.content.pm.ServiceInfo
import android.graphics.Bitmap
import android.graphics.Rect
import android.graphics.PixelFormat
import android.hardware.display.DisplayManager
import android.hardware.display.VirtualDisplay
import android.media.ImageReader
import android.media.projection.MediaProjection
import android.media.projection.MediaProjectionManager
import android.os.Build
import android.os.Handler
import android.os.HandlerThread
import android.os.IBinder
import android.util.Log
import androidx.core.app.NotificationCompat
import com.google.mlkit.vision.common.InputImage
import com.google.mlkit.vision.text.TextRecognition
import com.google.mlkit.vision.text.latin.TextRecognizerOptions

/**
 * User-approved Uber Trip Radar OCR.
 *
 * - Screen capture starts only after Android consent.
 * - OCR is fully on-device.
 * - No screenshots are uploaded.
 * - No automatic click occurs in this service.
 */
class UberScreenCaptureService : Service() {

    companion object {

        private const val TAG =
            "UberScreenCapture"

        private const val CHANNEL_ID =
            "uber_screen_capture"

        private const val NOTIFICATION_ID =
            9204


        const val ACTION_START_CAPTURE =
            "com.aistudio.smartdrivo.START_UBER_SCREEN_CAPTURE"

        const val ACTION_STOP_CAPTURE =
            "com.aistudio.smartdrivo.STOP_UBER_SCREEN_CAPTURE"
        // Internal bridge: verified OCR offer -> AccessibilityService.
        // This broadcast never leaves the SmartDrivo package.
        const val ACTION_OCR_OFFER =
            "com.aistudio.smartdrivo.UBER_OCR_OFFER"

        const val EXTRA_OCR_FARE = "uber_ocr_fare"
        const val EXTRA_OCR_PICKUP_KM = "uber_ocr_pickup_km"
        const val EXTRA_OCR_TRIP_KM = "uber_ocr_trip_km"
        const val EXTRA_OCR_PICKUP_ADDRESS = "uber_ocr_pickup_address"
        const val EXTRA_OCR_DROP_ADDRESS = "uber_ocr_drop_address"
        const val EXTRA_OCR_ACTION = "uber_ocr_action"
        const val EXTRA_OCR_LEFT = "uber_ocr_left"
        const val EXTRA_OCR_TOP = "uber_ocr_top"
        const val EXTRA_OCR_RIGHT = "uber_ocr_right"
        const val EXTRA_OCR_BOTTOM = "uber_ocr_bottom"


        const val EXTRA_RESULT_CODE =
            "media_projection_result_code"

        const val EXTRA_RESULT_DATA =
            "media_projection_result_data"


        @Volatile
        var isRunning: Boolean = false
            private set
    }


    private var mediaProjection:
        MediaProjection? = null

    private var virtualDisplay:
        VirtualDisplay? = null

    private var imageReader:
        ImageReader? = null


    private var captureThread:
        HandlerThread? = null

    private var captureHandler:
        Handler? = null


    private val recognizer =
        TextRecognition.getClient(
            TextRecognizerOptions.DEFAULT_OPTIONS
        )


    @Volatile
    private var ocrBusy =
        false


    @Volatile
    private var lastOcrAt =
        0L
    // UBER_SPATIAL_PARSER_V1
    private data class UberOcrLine(
        val text: String,
        val bounds: Rect
    )

    @Volatile
    private var lastStrongUberFare: Float? =
        null

    @Volatile
    private var lastStrongUberFareAt: Long =
        0L


    @Volatile
    private var lastUberCardDumpAt =
        0L
    @Volatile
    private var lastOcrOfferBroadcastKey: String? = null

    @Volatile
    private var lastOcrOfferBroadcastAt: Long = 0L


    override fun onCreate() {

        super.onCreate()

        createNotificationChannel()

        captureThread =
            HandlerThread(
                "SmartDrivoUberOCR"
            ).apply {
                start()
            }

        captureHandler =
            Handler(
                captureThread!!.looper
            )
    }


    override fun onStartCommand(
        intent: Intent?,
        flags: Int,
        startId: Int
    ): Int {

        when (intent?.action) {

            ACTION_START_CAPTURE -> {

                startCaptureForeground()

                val resultCode =
                    intent.getIntExtra(
                        EXTRA_RESULT_CODE,
                        Int.MIN_VALUE
                    )


                val resultData =
                    if (
                        Build.VERSION.SDK_INT >=
                        Build.VERSION_CODES.TIRAMISU
                    ) {

                        intent.getParcelableExtra(
                            EXTRA_RESULT_DATA,
                            Intent::class.java
                        )

                    } else {

                        @Suppress("DEPRECATION")
                        intent.getParcelableExtra<Intent>(
                            EXTRA_RESULT_DATA
                        )
                    }


                if (
                    resultCode ==
                    Int.MIN_VALUE ||
                    resultData == null
                ) {

                    Log.e(
                        TAG,
                        "Missing MediaProjection consent result"
                    )

                    stopCaptureService()

                    return START_NOT_STICKY
                }


                try {

                    startProjection(
                        resultCode,
                        resultData
                    )

                } catch (e: Exception) {

                    Log.e(
                        TAG,
                        "Unable to start MediaProjection",
                        e
                    )

                    stopCaptureService()
                }
            }


            ACTION_STOP_CAPTURE -> {
                stopCaptureService()
            }
        }


        return START_NOT_STICKY
    }


    private fun startCaptureForeground() {

        val notification: Notification =
            NotificationCompat.Builder(
                this,
                CHANNEL_ID
            )
                .setSmallIcon(
                    android.R.drawable.ic_menu_view
                )
                .setContentTitle(
                    "SmartDrivo Uber Scanner"
                )
                .setContentText(
                    "Uber order recognition active"
                )
                .setOngoing(true)
                .setSilent(true)
                .build()


        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.Q
        ) {

            startForeground(
                NOTIFICATION_ID,
                notification,
                ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION
            )

        } else {

            startForeground(
                NOTIFICATION_ID,
                notification
            )
        }
    }


    private fun startProjection(
        resultCode: Int,
        resultData: Intent
    ) {

        if (isRunning) {
            return
        }


        val manager =
            getSystemService(
                MediaProjectionManager::class.java
            )


        val projection =
            manager.getMediaProjection(
                resultCode,
                resultData
            ) ?: run {

                Log.e(
                    TAG,
                    "MediaProjection unavailable"
                )

                stopCaptureService()
                return
            }


        mediaProjection =
            projection


        projection.registerCallback(
            object :
                MediaProjection.Callback() {

                override fun onStop() {

                    Log.i(
                        TAG,
                        "MediaProjection stopped by user/system"
                    )

                    releaseCaptureResources(
                        stopProjection = false
                    )

                    stopSelf()
                }
            },
            captureHandler
        )


        val metrics =
            resources.displayMetrics


        val width =
            metrics.widthPixels

        val height =
            metrics.heightPixels

        val density =
            metrics.densityDpi


        imageReader =
            ImageReader.newInstance(
                width,
                height,
                PixelFormat.RGBA_8888,
                2
            )


        imageReader
            ?.setOnImageAvailableListener(
                { reader ->
                    processLatestImage(
                        reader,
                        width,
                        height
                    )
                },
                captureHandler
            )


        virtualDisplay =
            projection.createVirtualDisplay(
                "SmartDrivoUberOCR",
                width,
                height,
                density,
                DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
                imageReader?.surface,
                null,
                captureHandler
            )


        isRunning =
            true


        Log.i(
            TAG,
            "UBER OCR STARTED width=$width height=$height density=$density"
        )
    }


    private fun processLatestImage(
        reader: ImageReader,
        screenWidth: Int,
        screenHeight: Int
    ) {

        val now =
            System.currentTimeMillis()


        // OCR about twice per second.
        if (
            ocrBusy ||
            now - lastOcrAt < 500L
        ) {

            reader.acquireLatestImage()
                ?.close()

            return
        }


        val image =
            reader.acquireLatestImage()
                ?: return


        try {

            val plane =
                image.planes.firstOrNull()
                    ?: return


            val buffer =
                plane.buffer


            val pixelStride =
                plane.pixelStride

            val rowStride =
                plane.rowStride

            val rowPadding =
                rowStride -
                    pixelStride *
                    screenWidth


            val bitmapWidth =
                screenWidth +
                    rowPadding /
                    pixelStride


            val padded =
                Bitmap.createBitmap(
                    bitmapWidth,
                    screenHeight,
                    Bitmap.Config.ARGB_8888
                )


            padded.copyPixelsFromBuffer(
                buffer
            )


            val bitmap =
                Bitmap.createBitmap(
                    padded,
                    0,
                    0,
                    screenWidth,
                    screenHeight
                )


            if (padded !== bitmap) {
                padded.recycle()
            }


            lastOcrAt =
                now

            ocrBusy =
                true


            val input =
                InputImage.fromBitmap(
                    bitmap,
                    0
                )


            recognizer
                .process(input)
                .addOnSuccessListener {
                    result ->

                    val text =
                        result.text
                            .trim()
                    val spatialLines =
                        result.textBlocks
                            .flatMap { block ->
                                block.lines
                            }
                            .mapNotNull { line ->

                                val box =
                                    line.boundingBox
                                        ?: return@mapNotNull null

                                UberOcrLine(
                                    text = line.text.trim(),
                                    bounds = Rect(box)
                                )
                            }

                    parseUberSpatialCard(
                        lines = spatialLines,
                        screenHeight = screenHeight
                    )



                    if (text.isNotBlank()) {

                        val compact =
                            text
                                .replace(
                                    "\r",
                                    " "
                                )
                                .replace(
                                    "\n",
                                    " | "
                                )


                        Log.i(
                            TAG,
                            "UBER OCR TEXT: $compact"
                        )


                        val important =
                            result.textBlocks
                                .flatMap {
                                    block ->
                                    block.lines
                                }
                                .filter {
                                    line ->

                                    val value =
                                        line.text


                                    value.contains("₹") ||
                                        value.contains(
                                            "km",
                                            ignoreCase = true
                                        ) ||
                                        value.contains(
                                            "Match",
                                            ignoreCase = true
                                        ) ||
                                        value.contains(
                                            "Accept",
                                            ignoreCase = true
                                        )
                                }



                        // UBER_CARD_LINE_DEBUG_V1
                        //
                        // When Match is visible, dump all OCR lines with
                        // screen bounds once every ~1.5 seconds.
                        // This lets us identify fare even when ML Kit
                        // reads "₹72" as only "72".
                        val hasMatch =
                            result.textBlocks
                                .flatMap { it.lines }
                                .any {
                                    it.text.contains(
                                        "Match",
                                        ignoreCase = true
                                    )
                                }

                        if (hasMatch) {

                            val debugNow =
                                System.currentTimeMillis()

                            if (
                                debugNow -
                                    lastUberCardDumpAt >
                                1500L
                            ) {

                                lastUberCardDumpAt =
                                    debugNow

                                Log.i(
                                    TAG,
                                    "UBER CARD LINES START"
                                )

                                result.textBlocks
                                    .flatMap { it.lines }
                                    .forEach { line ->

                                        Log.i(
                                            TAG,
                                            "UBER CARD LINE: '${line.text}' bounds=${line.boundingBox}"
                                        )
                                    }

                                Log.i(
                                    TAG,
                                    "UBER CARD LINES END"
                                )
                            }
                        }
                        important.forEach {
                            line ->

                            Log.i(
                                TAG,
                                "UBER OCR HIT: '${line.text}' bounds=${line.boundingBox}"
                            )
                        }

                    } else {

                        Log.d(
                            TAG,
                            "UBER OCR: frame contained no recognized text"
                        )
                    }
                }
                .addOnFailureListener {
                    error ->

                    Log.w(
                        TAG,
                        "UBER OCR failed: ${error.message}"
                    )
                }
                .addOnCompleteListener {

                    try {
                        bitmap.recycle()
                    } catch (_: Exception) {
                    }

                    ocrBusy =
                        false
                }


        } catch (e: Exception) {

            ocrBusy =
                false

            Log.w(
                TAG,
                "Frame conversion failed: ${e.message}"
            )

        } finally {

            try {
                image.close()
            } catch (_: Exception) {
            }
        }
    }


    private fun parseUberSpatialCard(
        lines: List<UberOcrLine>,
        screenHeight: Int
    ) {

        if (lines.isEmpty()) {
            return
        }


        // ------------------------------------------------------
        // 1. REAL Uber action must be near bottom of screen.
        // This prevents SmartDrivo's "No Condition Match"
        // text from being mistaken for Uber Match.
        // ------------------------------------------------------

        val actionLine =
            lines
                .filter { line ->

                    val clean =
                        line.text.trim()

                    val isAction =
                        clean.equals(
                            "Match",
                            ignoreCase = true
                        ) ||
                        clean.equals(
                            "Accept",
                            ignoreCase = true
                        ) ||
                        clean.equals(
                            "Accept ride",
                            ignoreCase = true
                        ) ||
                        clean.equals(
                            "Accept trip",
                            ignoreCase = true
                        )

                    isAction &&
                        line.bounds.centerY() >
                        (screenHeight * 0.72f)
                }
                .maxByOrNull {
                    it.bounds.centerY()
                }
                ?: return


        // ------------------------------------------------------
        // 2. Uber card must contain Cash payment above action.
        // ------------------------------------------------------

        val cashLine =
            lines
                .filter {

                    it.text.contains(
                        "Cash payment",
                        ignoreCase = true
                    ) &&
                        it.bounds.centerY() <
                        actionLine.bounds.centerY()
                }
                .maxByOrNull {
                    it.bounds.centerY()
                }
                ?: return


        // Expired Uber request must never process.
        val expired =
            lines.any {

                val t =
                    it.text.lowercase()

                t.contains(
                    "request is no longer"
                ) ||
                    t.contains(
                        "no longer available"
                    ) ||
                    t.contains(
                        "trip is no longer"
                    )
            }


        if (expired) {

            Log.i(
                TAG,
                "UBER SPATIAL: expired request ignored"
            )

            return
        }


        // ------------------------------------------------------
        // 3. Pickup + trip distances.
        // Only values BETWEEN Cash payment and Match count.
        // ------------------------------------------------------

        val kmRegex =
            Regex(
                """(?i)([0-9]+(?:\.[0-9]+)?)\s*km"""
            )


        val distanceLines =
            lines
                .mapNotNull { line ->

                    if (
                        line.bounds.centerY() <=
                        cashLine.bounds.centerY() ||
                        line.bounds.centerY() >=
                        actionLine.bounds.centerY()
                    ) {
                        return@mapNotNull null
                    }


                    val match =
                        kmRegex.find(
                            line.text
                        )
                            ?: return@mapNotNull null


                    val value =
                        match.groupValues
                            .getOrNull(1)
                            ?.toFloatOrNull()
                            ?: return@mapNotNull null


                    if (
                        value <= 0f ||
                        value > 200f
                    ) {
                        return@mapNotNull null
                    }


                    Pair(
                        line,
                        value
                    )
                }
                .sortedBy {
                    it.first.bounds.centerY()
                }


        if (distanceLines.size < 2) {
            return
        }


        val pickupKm =
            distanceLines[0].second

        val tripKm =
            distanceLines[1].second


        val pickupDistanceLine =
            distanceLines[0].first

        val tripDistanceLine =
            distanceLines[1].first


        // ------------------------------------------------------
        // 4. Fare is immediately ABOVE "Cash payment".
        //
        // ML Kit on this Uber build reads:
        //
        // ₹52  -> sometimes "T52"
        // ₹52  -> sometimes "752"
        //
        // We accept T/₹/Rs as strong fare recognition.
        // A numeric-only "752" is NOT trusted by itself.
        // ------------------------------------------------------

        val fareRegionTop =
            cashLine.bounds.top -
                (screenHeight * 0.14f).toInt()


        val fareCandidates =
            lines
                .filter { line ->

                    line.bounds.centerY() >=
                        fareRegionTop &&
                        line.bounds.centerY() <
                        cashLine.bounds.top &&
                        line.bounds.left <
                        360
                }
                .sortedByDescending {
                    it.bounds.centerY()
                }


        var fare: Float? =
            null

        var fareRaw =
            ""


        for (line in fareCandidates) {

            val raw =
                line.text
                    .replace(" ", "")
                    .replace(",", "")


            // Strong OCR:
            // ₹52
            // T52
            // Rs52
            // INR52
            val strong =
                Regex(
                    """(?i)^(?:₹|T|Rs\.?|INR)([0-9]{1,4}(?:\.[0-9]{1,2})?)$"""
                )
                    .matchEntire(raw)


            if (strong != null) {

                val value =
                    strong.groupValues[1]
                        .toFloatOrNull()


                if (
                    value != null &&
                    value > 0f &&
                    value < 10000f
                ) {

                    fare =
                        value

                    fareRaw =
                        line.text

                    lastStrongUberFare =
                        value

                    lastStrongUberFareAt =
                        System.currentTimeMillis()

                    break
                }
            }
        }


        // Numeric-only OCR like "752":
        // trust it ONLY if a strong T52/₹52 reading happened
        // recently on another OCR frame.
        if (fare == null) {

            val recentStrong =
                lastStrongUberFare

            val recentAge =
                System.currentTimeMillis() -
                    lastStrongUberFareAt


            if (
                recentStrong != null &&
                recentAge <= 2500L
            ) {

                fare =
                    recentStrong

                fareRaw =
                    "recent-confirmed"
            }
        }


        // UBER NUMERIC FARE FALLBACK V3
        // Some current Uber cards are OCR'd without the rupee glyph:
        // "â‚¹56.70" may arrive as plain "56.70".
        // fareCandidates is already restricted to the small region directly
        // above "Cash payment", so accept a plausible numeric-only amount here.
        if (fare == null) {
            val numericFareRegex =
                Regex("""^[0-9]{2,4}(?:\.[0-9]{1,2})?$""")

            for (line in fareCandidates) {
                val rawNumeric =
                    line.text
                        .replace(" ", "")
                        .replace(",", "")
                        .trim()

                if (!numericFareRegex.matches(rawNumeric)) {
                    continue
                }

                val value =
                    rawNumeric.toFloatOrNull()
                        ?: continue

                if (
                    value >= 10f &&
                    value < 10000f
                ) {
                    fare = value
                    fareRaw = "numeric-spatial:${line.text}"

                    Log.i(
                        TAG,
                        "UBER NUMERIC FARE FALLBACK V3: accepted â‚¹$value from '${line.text}'"
                    )

                    break
                }
            }
        }

        if (
            fare == null ||
            fare <= 0f
        ) {

            Log.d(
                TAG,
                "UBER SPATIAL: waiting for strong fare OCR"
            )

            return
        }


        // ------------------------------------------------------
        // 5. Pickup address = text between pickup distance
        // and trip distance.
        // ------------------------------------------------------

        fun addressBetween(
            startY: Int,
            endY: Int
        ): String {

            return lines
                .filter {

                    val y =
                        it.bounds.centerY()

                    y > startY &&
                        y < endY &&
                        it.bounds.left < 680 &&
                        it.text.length >= 3 &&
                        !it.text.contains(
                            "km",
                            ignoreCase = true
                        )
                }
                .sortedBy {
                    it.bounds.centerY()
                }
                .joinToString(", ") {
                    it.text
                }
                .trim()
        }


        val pickupAddress =
            addressBetween(
                pickupDistanceLine.bounds.centerY(),
                tripDistanceLine.bounds.centerY()
            )


        val dropAddress =
            addressBetween(
                tripDistanceLine.bounds.centerY(),
                actionLine.bounds.centerY()
            )


        // ------------------------------------------------------
        // VERIFIED REAL UBER CARD
        // ------------------------------------------------------

        Log.i(
            TAG,
            "UBER PARSED OFFER: " +
                "fare=₹$fare " +
                "fareRaw='$fareRaw' " +
                "pickup=${pickupKm}km " +
                "trip=${tripKm}km " +
                "action='${actionLine.text}' " +
                "actionBounds=${actionLine.bounds} " +
                "pickupAddress='$pickupAddress' " +
                "dropAddress='$dropAddress'"
        )
        // Bridge only VERIFIED Uber cards. parseUberSpatialCard reaches this point
        // only after fare + Cash payment + two distances + a bottom Match/Accept
        // action have all been validated.
        val now = System.currentTimeMillis()
        val actionText = actionLine.text.trim()
        val offerKey = buildString {
            append(fare)
            append('|')
            append(pickupKm)
            append('|')
            append(tripKm)
            append('|')
            append(pickupAddress.take(48))
            append('|')
            append(dropAddress.take(48))
            append('|')
            append(actionText.lowercase())
        }

        if (
            offerKey != lastOcrOfferBroadcastKey ||
            now - lastOcrOfferBroadcastAt >= 1500L
        ) {
            lastOcrOfferBroadcastKey = offerKey
            lastOcrOfferBroadcastAt = now

            val bridgeIntent = Intent(ACTION_OCR_OFFER).apply {
                setPackage(packageName)
                putExtra(EXTRA_OCR_FARE, fare)
                putExtra(EXTRA_OCR_PICKUP_KM, pickupKm)
                putExtra(EXTRA_OCR_TRIP_KM, tripKm)
                putExtra(EXTRA_OCR_PICKUP_ADDRESS, pickupAddress)
                putExtra(EXTRA_OCR_DROP_ADDRESS, dropAddress)
                putExtra(EXTRA_OCR_ACTION, actionText)
                putExtra(EXTRA_OCR_LEFT, actionLine.bounds.left)
                putExtra(EXTRA_OCR_TOP, actionLine.bounds.top)
                putExtra(EXTRA_OCR_RIGHT, actionLine.bounds.right)
                putExtra(EXTRA_OCR_BOTTOM, actionLine.bounds.bottom)
            }

            sendBroadcast(bridgeIntent)

            Log.i(
                TAG,
                "UBER OCR BRIDGE SENT: fare=â‚¹$fare pickup=$pickupKm trip=$tripKm " +
                    "action='$actionText' bounds=${actionLine.bounds}"
            )
        }
    }

    private fun createNotificationChannel() {

        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.O
        ) {

            val manager =
                getSystemService(
                    NotificationManager::class.java
                )


            val channel =
                NotificationChannel(
                    CHANNEL_ID,
                    "Uber Screen Recognition",
                    NotificationManager.IMPORTANCE_LOW
                ).apply {

                    description =
                        "User-approved on-device Uber order recognition"

                    setSound(
                        null,
                        null
                    )
                }


            manager.createNotificationChannel(
                channel
            )
        }
    }


    private fun releaseCaptureResources(
        stopProjection: Boolean
    ) {

        isRunning =
            false


        try {

            imageReader
                ?.setOnImageAvailableListener(
                    null,
                    null
                )

        } catch (_: Exception) {
        }


        try {
            virtualDisplay?.release()
        } catch (_: Exception) {
        }

        virtualDisplay =
            null


        try {
            imageReader?.close()
        } catch (_: Exception) {
        }

        imageReader =
            null


        if (stopProjection) {

            try {
                mediaProjection?.stop()
            } catch (_: Exception) {
            }
        }


        mediaProjection =
            null
    }


    private fun stopCaptureService() {

        releaseCaptureResources(
            stopProjection = true
        )


        try {
            stopForeground(
                STOP_FOREGROUND_REMOVE
            )
        } catch (_: Exception) {
        }


        stopSelf()


        Log.i(
            TAG,
            "UBER OCR STOPPED"
        )
    }


    override fun onDestroy() {

        releaseCaptureResources(
            stopProjection = true
        )


        try {
            recognizer.close()
        } catch (_: Exception) {
        }


        try {
            captureThread?.quitSafely()
        } catch (_: Exception) {
        }


        super.onDestroy()
    }


    override fun onBind(
        intent: Intent?
    ): IBinder? = null
}